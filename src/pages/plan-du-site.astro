---
import Base from '../layouts/Base.astro';
import FilAriane from '../components/FilAriane.astro';
import { rubriques } from '../data/rubriques';
import { tousLesModules } from '../lib/navigation';
import { lien } from '../lib/chemins';
const modules = await tousLesModules();
---
<Base titre="Plan du site" description="Toutes les rubriques et tous les modules de Desclics sur une seule page : ordinateur, smartphone, Internet, démarches, sécurité, intelligence artificielle.">
  <div class="conteneur">
    <FilAriane miettes={[{ titre: 'Plan du site' }]} />
    <h1>Plan du site</h1>
    <div class="plan">
      {rubriques.map((r) => (
        <section aria-labelledby={`plan-${r.slug}`}>
          <h2 id={`plan-${r.slug}`}><a href={lien(r.slug)}>{r.titre}</a></h2>
          <ul>
            {modules.filter((m) => m.rubrique.slug === r.slug).map((m) => (
              <li>{m.publie ? <a href={lien(m.chemin)}>{m.titre}</a> : <span>{m.titre} <em>(en préparation)</em></span>}</li>
            ))}
          </ul>
        </section>
      ))}
      <section aria-labelledby="plan-outils">
        <h2 id="plan-outils">Outils et informations</h2>
        <ul>
          <li><a href={lien('glossaire')}>Glossaire</a></li>
          <li><a href={lien('glossaire/traducteur')}>Traducteur de jargon</a></li>
          <li><a href={lien('recherche')}>Recherche</a></li>
          <li><a href={lien('accessibilite')}>Déclaration d'accessibilité</a></li>
          <li><a href={lien('mentions-legales')}>Mentions légales</a></li>
          <li><a href={lien('confidentialite')}>Confidentialité</a></li>
        </ul>
      </section>
    </div>
  </div>
</Base>
<style>
  .plan { display: grid; gap: 1.5rem 3rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  h2 { font-size: 1.3rem; }
  h2 a { color: var(--texte); }
  ul { padding-left: 1.2rem; font-size: 1rem; }
  li { padding: .2rem 0; }
  em { color: var(--texte-doux); font-style: normal; font-size: .95em; }
</style>
