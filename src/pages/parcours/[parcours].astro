---
import Base from '../../layouts/Base.astro';
import FilAriane from '../../components/FilAriane.astro';
import Icone from '../../components/Icone.astro';
import { parcours, type Parcours } from '../../data/parcours';
import { trouverModule } from '../../lib/navigation';
import { lien } from '../../lib/chemins';

export function getStaticPaths() {
  return parcours.map((p) => ({ params: { parcours: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Parcours };

// Chaque étape doit viser un module publié : sinon, le build s'arrête (pas de lien mort).
const etapes = await Promise.all(p.etapes.map(async (e) => {
  const m = await trouverModule(e.module);
  if (!m?.publie) throw new Error(`Parcours « ${p.slug} » : le module « ${e.module} » n'est pas publié.`);
  return { ...e, m, href: lien(`${m.chemin}${e.ancre ? `#${e.ancre}` : ''}`) };
}));
const autres = parcours.filter((x) => x.slug !== p.slug);
const url = new URL(lien(`parcours/${p.slug}`), Astro.site).href;
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'HowTo', name: p.titre, description: p.metaDescription,
  inLanguage: 'fr-FR', url, totalTime: `PT${p.duree}M`,
  step: etapes.map((e, i) => ({ '@type': 'HowToStep', position: i + 1, name: e.titre, text: e.texte, url: new URL(e.href, Astro.site).href })),
}];
---
<Base titre={p.titreSeo} description={p.metaDescription} jsonld={jsonld}>
  <div class="conteneur">
    <FilAriane miettes={[{ titre: 'Parcours', chemin: 'parcours' }, { titre: p.titre }]} />
    <header class:list={['carte parcours-entete', `pastel-${p.pastel}`]}>
      <span class="pastille"><Icone nom={p.icone} /></span>
      <p class="etiquette">Parcours · {etapes.length} étapes</p>
      <h1>{p.titre}</h1>
      <p class="chapo">{p.chapo}</p>
    </header>

    <div class="parcours-grille">
      <section aria-labelledby="etapes-titre">
        <h2 id="etapes-titre">Les étapes, dans l'ordre</h2>
        <ol class="etapes-parcours">
          {etapes.map((e) => (
            <li class="carte carte--blanche carte-lien">
              <h3><a href={e.href}>{e.titre}</a></h3>
              <p>{e.texte}</p>
              <p class="vers"><Icone nom="fleche" taille={18} /> Module « {e.m.titre} »</p>
            </li>
          ))}
        </ol>
      </section>

      <aside class="parcours-cote">
        <div class="carte a-retenir">
          <h2>À retenir</h2>
          <ul>{p.aRetenir.map((l) => <li>{l}</li>)}</ul>
        </div>
        <div class="carte carte--blanche">
          <h2>Besoin d'une aide en personne ?</h2>
          <p>Des lieux d'accompagnement gratuits existent près de chez vous.</p>
          <p><a href={lien('aide-pres-de-chez-vous')}>Où se faire aider</a></p>
        </div>
      </aside>
    </div>

    <nav aria-labelledby="autres-titre" class="autres ne-pas-imprimer">
      <h2 id="autres-titre">Les autres parcours</h2>
      <ul>
        {autres.map((x) => <li><a href={lien(`parcours/${x.slug}`)}>Je viens {x.situation}</a></li>)}
      </ul>
    </nav>
  </div>
</Base>
<style>
  .parcours-entete { padding: 2rem; margin-bottom: 2.5rem; }
  .parcours-entete .etiquette { margin-top: 1.5rem; }
  .parcours-entete h1 { margin-top: .75rem; }
  .parcours-entete .chapo { color: var(--texte); margin-bottom: 0; }
  .parcours-grille { display: grid; gap: 2rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1024px) { .parcours-grille { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 3rem; } }
  h2 { font-size: 1.5rem; }
  .etapes-parcours { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 1rem; counter-reset: etape; }
  .etapes-parcours li { counter-increment: etape; padding-left: 4.5rem; }
  .etapes-parcours li::before {
    content: counter(etape); position: absolute; left: 1.5rem; top: 1.6rem;
    width: 2.2rem; height: 2.2rem; border-radius: 50%; display: grid; place-items: center;
    background: var(--accent); color: var(--sur-accent); font: 700 1.1rem var(--police-titre);
  }
  .etapes-parcours h3 { font-size: 1.2rem; margin: 0 0 .4rem; }
  .etapes-parcours h3 a { color: var(--texte); text-decoration: none; }
  .etapes-parcours li:hover h3 a { text-decoration: underline; }
  .etapes-parcours p { margin: 0 0 .4rem; font-size: 1rem; }
  .vers { display: flex; align-items: center; gap: .4rem; color: var(--accent); font: 600 .95rem var(--police-titre); }
  .parcours-cote { display: grid; gap: 1rem; align-content: start; }
  .parcours-cote h2 { font-size: 1.25rem; margin-top: 0; }
  .parcours-cote ul { padding-left: 1.2rem; margin: 0; }
  .parcours-cote li { margin-bottom: .5rem; }
  .a-retenir { background: var(--teinte); }
  .autres { margin-top: 3rem; border-top: 1px solid var(--trait); padding-top: 1.5rem; }
  .autres ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .6rem; }
  .autres a { display: inline-flex; align-items: center; min-height: var(--cible); padding: .5rem 1.1rem; border-radius: 999px; background: var(--surface-2); color: var(--texte); text-decoration: none; font: 500 1.05rem var(--police-titre); }
  .autres a:hover { color: var(--accent); }
  @media (max-width: 479px) { .etapes-parcours li { padding-left: 1.5rem; padding-top: 4rem; } .etapes-parcours li::before { top: 1.3rem; } }
</style>
