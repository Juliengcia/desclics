---
import Logo from './Logo.astro';
import { rubriques } from '../data/rubriques';
import { lien } from '../lib/chemins';
import { site } from '../data/site';
---
<footer class="site-pied">
  <div class="conteneur pied-grille">
    <div class="pied-marque">
      <a href={lien()} class="pied-logo"><Logo taille={30} /> <span>{site.nom}</span></a>
      <p>{site.accroche} Gratuit, sans compte, sans publicité, sans traceur.</p>
    </div>
    <nav aria-label="Rubriques (pied de page)">
      <h2 class="pied-titre">Rubriques</h2>
      <ul class="pied-colonnes">
        {rubriques.map((r) => <li><a href={lien(r.slug)}>{r.titre}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Informations">
      <h2 class="pied-titre">Le site</h2>
      <ul>
        <li><a href={lien('glossaire')}>Glossaire</a></li>
        <li><a href={lien('glossaire/traducteur')}>Traducteur de jargon</a></li>
        <li><a href={lien('plan-du-site')}>Plan du site</a></li>
        <li><a href={lien('accessibilite')}>Accessibilité : non conforme (audit à venir)</a></li>
        <li><a href={lien('mentions-legales')}>Mentions légales</a></li>
        <li><a href={lien('confidentialite')}>Confidentialité</a></li>
      </ul>
    </nav>
  </div>
</footer>
<style>
  .site-pied { margin-top: 4rem; border-top: 1px solid var(--trait); background: var(--surface); padding: 2.5rem 0 3rem; font-size: 1rem; }
  .pied-grille { display: grid; gap: 2rem; grid-template-columns: 1fr; }
  @media (min-width: 768px) { .pied-grille { grid-template-columns: 1.2fr 1.6fr 1fr; } }
  .pied-logo { display: inline-flex; align-items: center; gap: .5rem; color: var(--accent); text-decoration: none; font: 700 1.3rem var(--police-titre); }
  .pied-logo span { color: var(--texte); }
  .pied-marque p { color: var(--texte-doux); max-width: 32ch; }
  .pied-titre { font-size: 1rem; text-transform: uppercase; letter-spacing: .08em; color: var(--texte-doux); }
  ul { list-style: none; margin: 0; padding: 0; }
  li a { display: inline-block; padding: .35rem 0; color: var(--texte); text-decoration: none; min-height: 44px; line-height: 1.5; }
  @media (min-width: 768px) { li a { min-height: 0; } }
  li a:hover { color: var(--accent); text-decoration: underline; }
  .pied-colonnes { columns: 2; column-gap: 1.5rem; }
</style>
