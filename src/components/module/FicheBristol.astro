---
/** Fiche Bristol : récapitulatif imprimable au format A5. Générée depuis les métadonnées du module. */
import Icone from '../Icone.astro';
import { site } from '../../data/site';
interface Props { titre: string; lignes: string[]; adresse: string; seule?: boolean; ident?: string; niveauTitre?: 2 | 3 }
const { titre, lignes, adresse, seule = true, ident = 'fiche-bristol', niveauTitre = 2 } = Astro.props;
const Titre = `h${niveauTitre}`;
---
<section class="fiche-bristol" aria-labelledby={`${ident}-titre`} id={ident}>
  <div class="fiche-entete">
    <Titre id={`${ident}-titre`} class="fiche-h"><span class="fiche-type">Fiche Bristol</span> {titre}</Titre>
    {seule && <button type="button" class="bouton bouton--secondaire ne-pas-imprimer" data-imprimer-fiche><Icone nom="imprimer" /> Imprimer la fiche</button>}
  </div>
  <ul>{lignes.map((l) => <li set:html={l} />)}</ul>
  <p class="fiche-source">{site.nom} · {adresse}</p>
</section>
<style>
  .fiche-bristol { margin: 2.5rem 0; padding: 1.5rem 1.5rem 1rem; border-radius: 8px; background: #FFFDF6; color: #16181D; border: 1px solid #D9CFB4;
    background-image: repeating-linear-gradient(to bottom, transparent 0, transparent calc(2.2rem - 1px), #D8E3F5 calc(2.2rem - 1px), #D8E3F5 2.2rem);
    background-position: 0 3.2rem; box-shadow: var(--ombre); }
  :global(:root[data-theme-effectif='dark']) .fiche-bristol { background-color: #1D1F24; color: #ECEDEF; border-color: #3A3F4A;
    background-image: repeating-linear-gradient(to bottom, transparent 0, transparent calc(2.2rem - 1px), #2A3550 calc(2.2rem - 1px), #2A3550 2.2rem); }
  .fiche-entete { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: .75rem; }
  .fiche-h { font-size: 1.5rem; margin: 0 0 .75rem; }
  .fiche-type { display: block; font-size: .8rem; text-transform: uppercase; letter-spacing: .1em; color: #B4430B; }
  :global(:root[data-theme-effectif='dark']) .fiche-type { color: #FFA06B; }
  ul { margin: 0; padding-left: 1.2rem; line-height: 2.2rem; }
  .fiche-source { margin: .75rem 0 0; font-size: .85rem; opacity: .8; }
  .fiche-bristol :global(kbd) { background: transparent; }
  @media print {
    .fiche-bristol { box-shadow: none; border: 1px solid #000; break-inside: avoid; background-image: none; }
  }
</style>
<script>
  document.querySelectorAll('[data-imprimer-fiche]').forEach((b) =>
    b.addEventListener('click', () => {
      document.documentElement.classList.add('impression-fiche');
      window.print();
      setTimeout(() => document.documentElement.classList.remove('impression-fiche'), 500);
    }),
  );
</script>
<style is:global>
  @media print {
    @page { size: A5; margin: 12mm; }
    html.impression-fiche body > *:not(main), html.impression-fiche main > *:not(.module) { display: none !important; }
    html.impression-fiche .module > *:not(.module-grille), html.impression-fiche .module-grille > *:not(.module-contenu),
    html.impression-fiche .module-contenu > *:not(#fiche-bristol) { display: none !important; }
  }
</style>
