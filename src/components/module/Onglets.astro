---
/**
 * Onglets par appareil. Le choix fait une fois (panneau Accessibilité ou onglet) est mémorisé.
 * <Onglets appareils={['windows','mac']}>
 *   <Onglet appareil="windows">…</Onglet>
 *   <Onglet appareil="mac">…</Onglet>
 * </Onglets>
 * Sans JavaScript, tous les panneaux s'affichent les uns sous les autres, avec leur titre.
 */
interface Props { appareils: ('windows' | 'mac' | 'android' | 'iphone')[]; libelle?: string }
const { appareils, libelle = 'Choisir votre appareil' } = Astro.props;
const noms = { windows: 'Windows', mac: 'Mac', android: 'Android', iphone: 'iPhone' };
const uid = `ong-${Math.random().toString(36).slice(2, 8)}`;
---
<div class="onglets" data-onglets data-uid={uid}>
  <div class="onglets-liste" role="tablist" aria-label={libelle} hidden>
    {appareils.map((a, i) => (
      <button type="button" role="tab" id={`${uid}-tab-${a}`} aria-controls={`${uid}-${a}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-appareil={a}>{noms[a]}</button>
    ))}
  </div>
  <div class="onglets-panneaux"><slot /></div>
</div>
<style>
  .onglets { margin: 1.5rem 0; }
  .onglets-liste { display: flex; flex-wrap: wrap; gap: .4rem; padding: .3rem; border-radius: 14px; background: var(--surface-2); width: fit-content; max-width: 100%; }
  .onglets-liste button { min-height: 44px; padding: 0 1.1rem; border-radius: 10px; border: 0; background: transparent; color: var(--texte); font: 600 1rem var(--police-titre); cursor: pointer; }
  .onglets-liste button[aria-selected='true'] { background: var(--surface); box-shadow: var(--ombre); color: var(--accent); }
  .onglets-liste button:hover { text-decoration: underline; }
</style>
<script>
  type Fn = (v: string) => void;
  document.querySelectorAll<HTMLElement>('[data-onglets]').forEach((bloc) => {
    const uid = bloc.dataset.uid!;
    const liste = bloc.querySelector<HTMLElement>('[role=tablist]')!;
    const tabs = Array.from(liste.querySelectorAll<HTMLButtonElement>('[role=tab]'));
    const panneaux = Array.from(bloc.querySelectorAll<HTMLElement>(':scope > .onglets-panneaux > [data-onglet]'));
    panneaux.forEach((p) => {
      p.id = `${uid}-${p.dataset.onglet}`;
      p.setAttribute('role', 'tabpanel');
      p.setAttribute('aria-labelledby', `${uid}-tab-${p.dataset.onglet}`);
      p.tabIndex = 0;
      p.querySelector('.onglet-titre')?.classList.add('visually-hidden');
    });
    liste.hidden = false;
    function activer(a: string, focus = false) {
      if (!tabs.some((t) => t.dataset.appareil === a)) return false;
      tabs.forEach((t) => { const ok = t.dataset.appareil === a; t.setAttribute('aria-selected', String(ok)); t.tabIndex = ok ? 0 : -1; if (ok && focus) t.focus(); });
      panneaux.forEach((p) => (p.hidden = p.dataset.onglet !== a));
      return true;
    }
    activer(document.documentElement.getAttribute('data-appareil') ?? '') || activer(tabs[0].dataset.appareil!);
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => {
        const choisir = (window as unknown as { desclicsChoisirAppareil?: Fn }).desclicsChoisirAppareil;
        if (choisir) choisir(t.dataset.appareil!); else activer(t.dataset.appareil!);
      });
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (e.key === 'Home' || e.key === 'End' || d) {
          e.preventDefault();
          const j = e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : (i + d + tabs.length) % tabs.length;
          activer(tabs[j].dataset.appareil!, true);
        }
      });
    });
    document.addEventListener('desclics:appareil', (e) => activer((e as CustomEvent<string>).detail));
  });
</script>
