---
/**
 * Explications par appareil. S'adapte au choix « Mon appareil » (un, plusieurs ou tous),
 * détecté automatiquement au départ et modifiable dans le panneau Accessibilité ou ici.
 * <Onglets appareils={['windows','mac']}>
 *   <Onglet appareil="windows">…</Onglet>
 *   <Onglet appareil="mac">…</Onglet>
 * </Onglets>
 * - Seuls les appareils choisis s'affichent (Windows seul = Windows ; Windows + Mac = les deux).
 * - Si aucun appareil choisi ne concerne ce bloc (sujet mobile lu sur un ordinateur, ou l'inverse),
 *   toutes ses versions s'affichent : Android et iPhone, ou Windows et Mac.
 * - Sans JavaScript, tous les panneaux s'affichent les uns sous les autres, avec leur titre.
 */
interface Props { appareils: ('windows' | 'mac' | 'android' | 'iphone')[]; libelle?: string }
const { appareils, libelle = 'Afficher les explications pour' } = Astro.props;
const noms = { windows: 'Windows', mac: 'Mac', android: 'Android', iphone: 'iPhone' };
---
<div class="onglets" data-onglets data-appareils-bloc={appareils.join(',')}>
  <div class="onglets-choix ne-pas-imprimer" role="group" aria-label={libelle} hidden>
    <span class="onglets-libelle" aria-hidden="true">Afficher pour :</span>
    {appareils.map((a) => (
      <button type="button" class="onglets-puce" aria-pressed="true" data-appareil={a} data-infobulle={`Afficher ou masquer les explications pour ${noms[a]}`}>
        <svg class="puce-coche" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"/></svg>{noms[a]}
      </button>
    ))}
  </div>
  <div class="onglets-panneaux"><slot /></div>
</div>
<style>
  .onglets { margin: 1.5rem 0; }
  .onglets-choix { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin-bottom: .5rem; }
  .onglets-libelle { font: 600 .95rem var(--police-titre); color: var(--texte-doux); margin-right: .25rem; }
  .onglets-puce { display: inline-flex; align-items: center; gap: .35rem; min-height: 44px; padding: 0 1rem; border-radius: 999px;
    border: 1px solid var(--bordure); background: var(--surface); color: var(--texte); font: 600 1rem var(--police-titre); cursor: pointer; }
  .onglets-puce .puce-coche { display: none; }
  .onglets-puce[aria-pressed='true'] { background: var(--accent-pale); border: 2px solid var(--accent); color: var(--accent); }
  .onglets-puce[aria-pressed='true'] .puce-coche { display: block; }
  .onglets-puce:hover { border-color: var(--accent); }
  .onglets-panneaux > :global([data-onglet] + [data-onglet]:not([hidden])) { border-top: 1px dashed var(--trait); margin-top: .5rem; }
</style>
<script>
  import { appareilsAffiches, basculerAppareil } from '../../scripts/appareils';
  document.querySelectorAll<HTMLElement>('[data-onglets]').forEach((bloc) => {
    const propres = bloc.dataset.appareilsBloc!.split(',');
    const choix = bloc.querySelector<HTMLElement>('.onglets-choix')!;
    const puces = Array.from(choix.querySelectorAll<HTMLButtonElement>('[data-appareil]'));
    const panneaux = Array.from(bloc.querySelectorAll<HTMLElement>(':scope > .onglets-panneaux > [data-onglet]'));
    if (propres.length > 1) choix.hidden = false;
    function maj() {
      const montres = appareilsAffiches(propres);
      panneaux.forEach((p) => (p.hidden = !montres.includes(p.dataset.onglet!)));
      puces.forEach((b) => b.setAttribute('aria-pressed', String(montres.includes(b.dataset.appareil!))));
    }
    puces.forEach((b) => b.addEventListener('click', () => {
      const montres = appareilsAffiches(propres);
      const a = b.dataset.appareil!;
      if (montres.length === 1 && montres[0] === a) return; // garder au moins une version
      basculerAppareil(a, montres);
    }));
    maj();
    document.addEventListener('desclics:appareils', maj);
  });
</script>
