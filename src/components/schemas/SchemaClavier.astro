---
/**
 * Schéma d'un clavier AZERTY français (ordinateur Windows), simplifié.
 * Les touches numérotées correspondent à la légende du module « Le clavier et les raccourcis ».
 */
type Touche = [label: string, largeur?: number, numero?: number];
const rangees: Touche[][] = [
  [['Échap', 1.2, 1]],
  [['²'], ['1 &'], ['2 é'], ['3 "'], ["4 '"], ['5 ('], ['6 -'], ['7 è'], ['8 _'], ['9 ç'], ['0 à'], ['°  )'], ['+ ='], ['⟵', 2, 11]],
  [['Tab ↹', 1.5, 2], ['A'], ['Z'], ['E'], ['R'], ['T'], ['Y'], ['U'], ['I'], ['O'], ['P'], ['¨ ^'], ['£ $'], ['Entrée', 1.5, 10]],
  [['Verr. Maj', 1.8, 3], ['Q'], ['S'], ['D'], ['F'], ['G'], ['H'], ['J'], ['K'], ['L'], ['M'], ['% ù'], ['µ *'], ['', 1.2]],
  [['⇧ Maj', 1.3, 4], ['>  <'], ['W'], ['X'], ['C'], ['V'], ['B'], ['N'], ['? ,'], ['. ;'], ['/ :'], ['§ !'], ['⇧ Maj', 2.7]],
  [['Ctrl', 1.4, 5], ['⊞', 1.2, 6], ['Alt', 1.2, 7], ['Espace', 6.4, 8], ['Alt Gr', 1.4, 9], ['Ctrl', 1.4], ['', 2.0]],
];
const U = 54, G = 6, X0 = 12, Y0 = 12;
const touches: { x: number; y: number; w: number; label: string; n?: number }[] = [];
rangees.forEach((r, i) => {
  let x = X0;
  for (const [label, l = 1, n] of r) {
    const w = l * U + (l - 1) * G;
    if (label !== '' || l < 2) touches.push({ x, y: Y0 + i * (U + G), w, label, n });
    x += w + G;
  }
});
const largeur = Math.max(...touches.map((t) => t.x + t.w)) + X0;
const hauteur = Y0 * 2 + rangees.length * (U + G) - G;
---
<svg class="schema-clavier schema-large" viewBox={`0 0 ${largeur} ${hauteur}`} xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  {touches.map((t) => (
    <g class:list={['touche', t.n && 'touche--repere']}>
      <rect x={t.x} y={t.y} width={t.w} height={U} rx="8" />
      {t.label && <text x={t.x + t.w / 2 + (t.n && t.w < 80 ? 6 : 0)} y={t.y + U / 2 + (t.n ? 13 : 6)} text-anchor="middle">{t.label}</text>}
      {t.n && (
        <g class="badge">
          <circle cx={t.x + 13} cy={t.y + 13} r="10" />
          <text x={t.x + 13} y={t.y + 17.5} text-anchor="middle">{t.n}</text>
        </g>
      )}
    </g>
  ))}
</svg>
<style>
  .schema-clavier { font-family: var(--police-titre); }
  .touche rect { fill: var(--surface); stroke: var(--bordure); stroke-width: 1.5; }
  .touche text { fill: var(--texte-doux); font-size: 15px; font-weight: 500; }
  .touche--repere rect { fill: var(--accent-pale); stroke: var(--accent); stroke-width: 3; }
  .touche--repere > text { fill: var(--texte); font-weight: 700; font-size: 13px; }
  .badge circle { fill: var(--accent); stroke: none; }
  .badge text { fill: var(--sur-accent); font-size: 13px; font-weight: 700; }
</style>
