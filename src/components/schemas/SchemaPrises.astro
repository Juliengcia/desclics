---
/** Schéma : formes simplifiées des prises les plus courantes, vues de face. */
const prises = [
  { n: 1, nom: 'USB-A', d: '<rect x="-34" y="-12" width="68" height="24" rx="2"/><rect x="-26" y="-12" width="52" height="10" class="plein"/>' },
  { n: 2, nom: 'USB-C', d: '<rect x="-28" y="-10" width="56" height="20" rx="10"/><rect x="-16" y="-3" width="32" height="6" rx="3" class="plein"/>' },
  { n: 3, nom: 'HDMI', d: '<path d="M-38 -12h76v12l-8 10h-60l-8-10z"/><path d="M-28 -4h56" class="fin"/>' },
  { n: 4, nom: 'DisplayPort', d: '<path d="M-34 -12h68v24h-58l-10-10z"/><path d="M-24 -2h48" class="fin"/>' },
  { n: 5, nom: 'VGA', d: '<path d="M-44 -14h88l-8 28h-72z"/>' + [-28,-14,0,14,28].map((x) => `<circle cx="${x}" cy="-5" r="2.5" class="plein"/>`).join('') + [-21,-7,7,21].map((x) => `<circle cx="${x}" cy="5" r="2.5" class="plein"/>`).join('') },
  { n: 6, nom: 'RJ45 (Ethernet)', d: '<path d="M-24 -16h48v26h-14v8h-20v-8h-14z"/>' + [-15,-9,-3,3,9,15].map((x) => `<path d="M${x} -16v8" class="fin"/>`).join('') },
  { n: 7, nom: 'Jack audio', d: '<circle r="16"/><circle r="6" class="plein"/>' },
  { n: 8, nom: 'Péritel', d: '<path d="M-48 -16h96v32h-84l-12-12z"/><path d="M-36 -6h80M-32 6h72" class="fin"/>' },
];
---
<svg class="schema-prises schema-large" viewBox="0 0 760 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  {prises.map((p, i) => {
    const x = 95 + (i % 4) * 190, y = 85 + Math.floor(i / 4) * 140;
    return (
      <g>
        <g class="prise" transform={`translate(${x} ${y}) scale(1.3)`} set:html={p.d} />
        <g class="badge"><circle cx={x - 70} cy={y - 40} r="14" /><text x={x - 70} y={y - 35} text-anchor="middle">{p.n}</text></g>
        <text x={x} y={y + 52} text-anchor="middle" class="nom">{p.nom}</text>
      </g>
    );
  })}
</svg>
<style>
  .schema-prises { font-family: var(--police-titre); }
  .prise :global(rect), .prise :global(path), .prise :global(circle) { fill: var(--surface); stroke: var(--texte); stroke-width: 2.2; stroke-linejoin: round; }
  .prise :global(.plein) { fill: var(--accent); stroke: none; }
  .prise :global(.fin) { fill: none; stroke-width: 1.6; }
  .badge circle { fill: var(--accent); }
  .badge text { fill: var(--sur-accent); font-weight: 700; font-size: 14px; }
  .nom { fill: var(--texte); font-size: 17px; font-weight: 600; }
</style>
