---
import { lien } from '../lib/chemins';
export interface Miette { titre: string; chemin?: string }
interface Props { miettes: Miette[] }
const { miettes } = Astro.props;
const toutes: Miette[] = [{ titre: 'Accueil', chemin: '' }, ...miettes];
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: toutes.map((m, i) => ({
    '@type': 'ListItem', position: i + 1, name: m.titre,
    ...(m.chemin !== undefined ? { item: new URL(lien(m.chemin), Astro.site).href } : {}),
  })),
};
---
<nav class="fil-ariane" aria-label="Fil d'Ariane">
  <ol>
    {toutes.map((m, i) => (
      <li>
        {i < toutes.length - 1 && m.chemin !== undefined
          ? <a href={lien(m.chemin)}>{m.titre}</a>
          : <span aria-current="page">{m.titre}</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
<style>
  .fil-ariane { font-size: 1rem; margin: 1.25rem 0 1.5rem; }
  ol { list-style: none; display: flex; flex-wrap: wrap; gap: .1rem .5rem; margin: 0; padding: 0; }
  li { display: inline-flex; align-items: center; gap: .5rem; }
  li + li::before { content: '›'; color: var(--texte-doux); }
  a { color: var(--texte-doux); display: inline-block; padding: .4rem 0; }
  a:hover { color: var(--accent); }
  [aria-current] { color: var(--texte); font-weight: 600; }
</style>
