---
import { lien } from '../lib/chemins';
import Icone from './Icone.astro';
export interface Miette { titre: string; chemin?: string }
interface Props { miettes: Miette[]; favori?: boolean }
/** Fil d'Ariane + bouton « Ajouter aux favoris » (toutes les pages sauf l'accueil). */
const { miettes, favori = true } = Astro.props;
const rubrique = miettes.length > 1 ? miettes[0].titre : '';
const toutes: Miette[] = [{ titre: 'Accueil', chemin: '' }, ...miettes];
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: toutes.map((m, i) => ({
    '@type': 'ListItem', position: i + 1, name: m.titre,
    ...(m.chemin !== undefined ? { item: new URL(lien(m.chemin), Astro.site).href } : {}),
  })),
};
---
<div class="outils-page">
<nav class="fil-ariane" aria-label="Fil d'Ariane">
  <ol>
    {toutes.map((m, i) => (
      <li>
        {i < toutes.length - 1 && m.chemin !== undefined
          ? <a href={lien(m.chemin)}>{m.titre}</a>
          : <span aria-current="page">{m.titre}</span>}
      </li>
    ))}
  </ol>
</nav>
{favori && (
  <div class="favori-zone ne-pas-imprimer">
    <button type="button" class="bouton-favori" aria-pressed="false" data-favori-bouton data-rubrique={rubrique}>
      <Icone nom="etoile" /><span data-favori-texte>Ajouter aux favoris</span>
    </button>
    <p class="visually-hidden" role="status" data-favoris-statut></p>
  </div>
)}
</div>
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
<style>
  .outils-page { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .25rem 1rem; margin: 1.25rem 0 1.5rem; }
  .fil-ariane { font-size: 1rem; min-width: 0; }
  .bouton-favori { display: inline-flex; align-items: center; gap: .45rem; min-height: 44px; padding: 0 1rem; border-radius: 999px;
    border: 1px solid var(--bordure); background: var(--surface); color: var(--texte); font: 600 .95rem var(--police-titre); cursor: pointer; }
  .bouton-favori:hover { border-color: var(--accent); color: var(--accent); }
  .bouton-favori :global(svg) { width: 1.2rem; height: 1.2rem; }
  .bouton-favori[aria-pressed='true'] { background: var(--accent-pale); border-color: var(--accent); color: var(--accent); }
  .bouton-favori[aria-pressed='true'] :global(svg) { fill: currentColor; }
  .favori-zone p { margin: 0; }
  ol { list-style: none; display: flex; flex-wrap: wrap; gap: .1rem .5rem; margin: 0; padding: 0; }
  li { display: inline-flex; align-items: center; gap: .5rem; }
  li + li::before { content: '›'; color: var(--texte-doux); }
  a { color: var(--texte-doux); display: inline-block; padding: .4rem 0; }
  a:hover { color: var(--accent); }
  [aria-current] { color: var(--texte); font-weight: 600; }
</style>
