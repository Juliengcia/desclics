---
/**
 * Recherche globale instantanée (Pagefind, index statique généré au build).
 * - mode « deroulant » (accueil, en-tête, boîte de dialogue mobile) : 3 à 5 résultats dans une liste
 *   par-dessus la page, puis « Voir tous les résultats ». Flèches du clavier, Entrée, Échap.
 * - mode « page » (/recherche/) : tous les résultats, en liste.
 * Le bouton micro n'apparaît que si le navigateur sait faire la dictée.
 */
import Icone from './Icone.astro';
import { lien } from '../lib/chemins';
interface Props { mode?: 'deroulant' | 'page'; id?: string; libelleVisible?: boolean; compact?: boolean }
const { mode = 'deroulant', id = 'recherche', libelleVisible = false, compact = false } = Astro.props;
---
<div class:list={['recherche', `recherche--${mode}`, { 'recherche--compacte': compact }]} data-recherche data-mode={mode}
  data-index={lien('pagefind/pagefind.js')} data-page-resultats={lien('recherche')}>
  <form role="search" class="recherche-form" action={lien('recherche')} method="get">
    <label for={`${id}-champ`} class={libelleVisible ? 'recherche-label' : 'visually-hidden'}>Que cherchez-vous ?</label>
    <div class="recherche-ligne">
      <Icone nom="recherche" class="recherche-loupe" />
      <input id={`${id}-champ`} name="q" type="search" autocomplete="off" spellcheck="false" enterkeyhint="search"
        placeholder={compact ? 'Que cherchez-vous ?' : 'Exemple : copier-coller'}
        data-recherche-champ
        {...(mode === 'deroulant'
          ? { role: 'combobox', 'aria-autocomplete': 'list', 'aria-expanded': 'false', 'aria-controls': `${id}-liste` }
          : { 'aria-describedby': `${id}-etat` })} />
      <button type="button" class="recherche-voix" data-recherche-voix hidden aria-pressed="false" data-infobulle="Chercher en parlant">
        <Icone nom="micro" /><span class="visually-hidden">Chercher à la voix</span>
      </button>
    </div>
  </form>
  {mode === 'deroulant' ? (
    <div class="recherche-deroulant" data-recherche-deroulant hidden>
      <ul id={`${id}-liste`} role="listbox" aria-label="Suggestions de résultats" class="recherche-options" data-recherche-resultats></ul>
      <p class="recherche-pied" data-recherche-pied></p>
    </div>
  ) : (
    <>
      <ol class="recherche-resultats" data-recherche-resultats></ol>
    </>
  )}
  <p id={`${id}-etat`} class:list={['recherche-etat', { 'visually-hidden': mode === 'deroulant' }]} role="status" aria-live="polite" data-recherche-etat></p>
  <p class="recherche-note" data-recherche-voix-note hidden></p>
</div>
<style>
  .recherche { position: relative; }
  .recherche-label { display: block; font: 650 1.2rem var(--police-titre); margin-bottom: .5rem; }
  .recherche-ligne { position: relative; display: flex; align-items: center; }
  :global(.recherche-loupe) { position: absolute; left: 1.1rem; color: var(--texte-doux); pointer-events: none; }
  input[type='search'] {
    flex: 1; min-width: 0; min-height: 60px; padding: .5rem 3.75rem .5rem 3.1rem;
    font: 1.15rem var(--police-texte); color: var(--texte); background: var(--surface);
    border: 2px solid var(--bordure); border-radius: 999px;
  }
  input[type='search']::placeholder { color: var(--texte-doux); opacity: 1; }
  input[type='search']:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-color: var(--accent); }
  .recherche-voix {
    position: absolute; right: 6px; display: inline-grid; place-items: center; width: 48px; height: 48px;
    border-radius: 50%; border: 0; background: var(--surface-2); color: var(--texte); cursor: pointer;
  }
  .recherche-voix :global(svg) { width: 1.35rem; height: 1.35rem; }
  .recherche-voix:hover { background: var(--accent-pale); color: var(--accent); }
  .recherche-voix[aria-pressed='true'] { background: var(--accent); color: var(--sur-accent); animation: pulsation 1.2s ease-in-out infinite; }
  @keyframes pulsation { 50% { box-shadow: 0 0 0 8px color-mix(in srgb, var(--accent) 25%, transparent); } }

  /* Version compacte (en-tête) : ressemble à un champ de saisie. */
  .recherche--compacte input[type='search'] { min-height: 48px; font-size: 1.02rem; padding-left: 2.75rem; padding-right: 3.2rem; background: var(--surface); border-width: 1px; }
  .recherche--compacte :global(.recherche-loupe) { left: .9rem; width: 1.25rem; height: 1.25rem; }
  .recherche--compacte .recherche-voix { width: 40px; height: 40px; right: 4px; }

  /* Liste déroulante : par-dessus la page, ne change pas la hauteur de la section. */
  .recherche-deroulant {
    position: absolute; z-index: 60; left: 0; right: 0; top: calc(100% + .5rem);
    background: var(--surface); color: var(--texte); border: 1px solid var(--bordure); border-radius: 20px;
    box-shadow: 0 18px 50px rgb(22 24 29 / .18); padding: .4rem; text-align: left;
    max-height: min(70vh, 34rem); overflow-y: auto;
  }
  .recherche--compacte .recherche-deroulant { min-width: min(30rem, calc(100vw - 2rem)); left: auto; }
  .recherche-options { list-style: none; margin: 0; padding: 0; }
  .recherche-options :global([role='option']) { display: block; padding: .7rem .9rem; border-radius: 14px; cursor: pointer; color: var(--texte); text-decoration: none; }
  .recherche-options :global([role='option'][aria-selected='true']), .recherche-options :global([role='option']:hover) { background: var(--accent-pale); outline: 2px solid var(--accent); outline-offset: -2px; }
  .recherche-options :global(.opt-titre) { display: block; font: 650 1.05rem/1.3 var(--police-titre); }
  .recherche-options :global(.opt-chapitre) { display: block; font-size: .95rem; color: var(--accent); margin-top: .1rem; }
  .recherche-options :global(.opt-extrait) { display: block; font-size: .95rem; color: var(--texte-doux); margin-top: .2rem; line-height: 1.45; }
  .recherche-options :global(.opt-extrait mark) { background: none; color: var(--texte); font-weight: 700; }
  .recherche-options :global(.opt-tous) { border-top: 1px solid var(--trait); margin-top: .3rem; font: 650 1rem var(--police-titre); color: var(--accent); display: flex; align-items: center; gap: .4rem; }
  .recherche-pied { margin: 0; padding: .6rem .9rem; font-size: .95rem; color: var(--texte-doux); }
  .recherche-pied:empty { display: none; }

  .recherche-etat { color: var(--texte-doux); font-size: 1rem; margin: .75rem 0 .25rem; min-height: 1.5em; }
  .recherche-note { font-size: .95rem; color: var(--texte-doux); margin: .5rem 0 0; }
  .recherche-resultats { list-style: none; padding: 0; margin: 0; display: grid; gap: .75rem; }
  .recherche-resultats :global(li) { background: var(--surface); border: 1px solid var(--trait); border-radius: var(--rayon); padding: 1rem 1.1rem; }
  .recherche-resultats :global(.res-titre) { font: 650 1.1rem var(--police-titre); }
  .recherche-resultats :global(.res-extrait) { margin: .35rem 0 0; font-size: 1rem; color: var(--texte-doux); }
  .recherche-resultats :global(.res-extrait mark) { background: var(--accent-pale); color: var(--texte); font-weight: 700; }
  .recherche-resultats :global(.res-sous) { list-style: none; margin: .5rem 0 0; padding: 0 0 0 1rem; border-left: 3px solid var(--trait); font-size: 1rem; }
  .recherche-resultats :global(.res-sous a) { display: inline-block; padding: .25rem 0; }
</style>
