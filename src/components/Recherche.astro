---
/**
 * Recherche globale instantanée (Pagefind, index statique généré au build).
 * S'ouvre dans une boîte de dialogue depuis l'en-tête, ou s'affiche en page (/recherche/).
 */
import Icone from './Icone.astro';
import { lien } from '../lib/chemins';
interface Props { enPage?: boolean; id?: string }
const { enPage = false, id = 'recherche' } = Astro.props;
---
<div class="recherche" data-recherche data-index={lien('pagefind/pagefind.js')}>
  <form role="search" class="recherche-form" onsubmit="return false">
    <label for={`${id}-champ`} class={enPage ? 'recherche-label' : 'visually-hidden'}>Que cherchez-vous ?</label>
    <div class="recherche-ligne">
      <Icone nom="recherche" class="recherche-loupe" />
      <input id={`${id}-champ`} type="search" autocomplete="off" spellcheck="false"
        placeholder="Exemple : copier-coller"
        aria-describedby={`${id}-etat`} data-recherche-champ />
      <button type="button" class="bouton-icone recherche-voix" data-recherche-voix hidden aria-pressed="false">
        <Icone nom="micro" /><span class="visually-hidden">Chercher à la voix</span>
      </button>
    </div>
  </form>
  <p id={`${id}-etat`} class="recherche-etat" role="status" aria-live="polite" data-recherche-etat></p>
  <p class="recherche-note" data-recherche-voix-note hidden>
    La recherche à la voix utilise la reconnaissance vocale de votre navigateur, qui peut transmettre votre voix à son éditeur.
  </p>
  <ol class="recherche-resultats" data-recherche-resultats></ol>
</div>
<style>
  .recherche-label { display: block; font: 650 1.2rem var(--police-titre); margin-bottom: .5rem; }
  .recherche-ligne { position: relative; display: flex; align-items: center; gap: .5rem; }
  :global(.recherche-loupe) { position: absolute; left: 1rem; color: var(--texte-doux); pointer-events: none; }
  input[type='search'] {
    flex: 1; min-width: 0; min-height: 56px; padding: .5rem 1rem .5rem 3rem;
    font: 1.15rem var(--police-texte); color: var(--texte); background: var(--surface);
    border: 2px solid var(--bordure); border-radius: 14px;
  }
  input[type='search']:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-color: var(--accent); }
  .recherche-voix { border: 2px solid var(--bordure); min-height: 56px; min-width: 56px; }
  .recherche-voix[aria-pressed='true'] { background: var(--accent); color: var(--sur-accent); border-color: var(--accent); }
  .recherche-etat { color: var(--texte-doux); font-size: 1rem; margin: .75rem 0 .25rem; min-height: 1.5em; }
  .recherche-note { font-size: .9rem; color: var(--texte-doux); }
  .recherche-resultats { list-style: none; padding: 0; margin: 0; display: grid; gap: .75rem; }
  .recherche-resultats :global(li) { background: var(--surface); border: 1px solid var(--trait); border-radius: var(--rayon); padding: 1rem 1.1rem; }
  .recherche-resultats :global(.res-titre) { font: 650 1.1rem var(--police-titre); }
  .recherche-resultats :global(.res-extrait) { margin: .35rem 0 0; font-size: 1rem; color: var(--texte-doux); }
  .recherche-resultats :global(.res-extrait mark) { background: var(--accent-pale); color: var(--texte); font-weight: 700; }
  .recherche-resultats :global(.res-sous) { list-style: none; margin: .5rem 0 0; padding: 0 0 0 1rem; border-left: 3px solid var(--trait); font-size: 1rem; }
  .recherche-resultats :global(.res-sous a) { display: inline-block; padding: .25rem 0; }
</style>
